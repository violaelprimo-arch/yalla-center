rules_version = '2';

// ===============================================================
// Assumed Data Models
// ===============================================================
//
// Collection: tenants
// Document ID: {tenantId}
// Fields:
//   - id: string (required) - Tenant identifier
//   - slug: string (required) - URL-friendly slug
//   - nameAr: string (required) - Arabic center name
//   - nameEn: string (optional) - English center name
//   - subscriptionPlan: string (optional)
//   - isActive: bool (required)
//   - settings: map (optional)
//   - createdAt: string/timestamp (optional)
//   - updatedAt: string/timestamp (optional)
//
// Collection: staff_memberships
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - uid: string (required) - Firebase Auth UID
//   - email: string (optional) - Staff email address
//   - displayName: string (optional) - Staff display name
//   - role: string (required) - PLATFORM_OWNER, CENTER_ADMIN, BRANCH_MANAGER, RECEPTIONIST, ACCOUNTANT, TEACHER
//   - tenantId: string (required) - Associated center/tenant identifier
//   - branchIds: list (optional) - Authorized branch IDs (empty or omitted means all branches)
//   - teacherId: string (optional) - Link to teacher record if role == 'TEACHER'
//   - isActive: bool (required) - Whether account is active
//
// Collection: master_stages
// Document ID: {tenantId}~{stageId}
// Fields:
//   - id: string (required) - Stage identifier
//   - tenantId: string (required, immutable) - Center/tenant ID
//   - nameAr: string (required) - Arabic stage title (e.g. الثانوية العامة)
//   - order: int/number (optional) - Display sort order
//   - grades: list of maps (optional) - Embedded educational grades
//   - createdAt: string/timestamp (optional)
//   - updatedAt: string/timestamp (optional)
//
// Collection: master_subjects
// Document ID: {tenantId}~{subjectId}
// Fields:
//   - id: string (required) - Subject identifier
//   - tenantId: string (required, immutable) - Center/tenant ID
//   - nameAr: string (required) - Arabic subject title (e.g. الرياضيات التطبيقية)
//   - code: string (optional) - Subject short code
//   - stage: string (required) - Associated stage ID
//   - grade: string (required) - Associated grade ID
//   - createdAt: string/timestamp (optional)
//   - updatedAt: string/timestamp (optional)
//
// Collection: master_branches
// Document ID: {tenantId}~{branchId}
// Fields:
//   - id: string (required) - Branch identifier
//   - tenantId: string (required, immutable) - Center/tenant ID
//   - nameAr: string (required) - Arabic branch name
//   - address: string (optional) - Branch street address
//   - phone: string (optional) - Branch telephone number
//   - isActive: bool (optional) - Branch active status
//   - createdAt: string/timestamp (optional)
//   - updatedAt: string/timestamp (optional)
//
// Collection: lesson_exams
// Document ID: {examId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - branchId: string (required, immutable)
//   - sessionId: string (required, immutable)
//   - groupId: string (required, immutable)
//   - teacherId: string (required)
//   - totalMarks: number (required, 1..1000)
//   - updatedByUid: string (required)
//   - version: int/number (required, incrementing)
//
// Collection: lesson_grades
// Document ID: {examId}_{studentId}
// Fields:
//   - id: string (required, must match {examId}_{studentId})
//   - tenantId: string (required, immutable)
//   - branchId: string (required)
//   - sessionId: string (required, immutable)
//   - groupId: string (required, immutable)
//   - examId: string (required, immutable)
//   - studentId: string (required, immutable)
//   - studentUid: string (optional, for student portal read)
//   - score: number (required, 0..totalMarks)
//   - recordedByUid: string (required)
//   - version: int/number (required, incrementing)
//
// Collection: lesson_grade_audits
// Document ID: {auditId}
// Fields:
//   - tenantId, branchId, sessionId, groupId, examId, action, actorUid,
//     previousScore, newScore, timestamp
//
// Collection: center_groups
// Document ID: {groupId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - nameAr: string (required)
//   - branchId: string (optional)
//   - classroomId: string (optional)
//   - subjectId: string (optional)
//   - teacherId: string (optional)
//
// Collection: center_classrooms
// Document ID: {classroomId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - branchId: string (optional)
//   - nameAr: string (required)
//   - capacity: number (optional)
//
// Collection: teacher_profiles
// Document ID: {profileId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - fullName: string (required)
//   - active: bool (optional)
//   - uid: string (optional)
//
// Collection: teacher_login_keys
// Document ID: {keyId}
// Fields:
//   - teacherId: string (required)
//   - tenantId: string (required, immutable)
//   - uid: string (optional)
//
// Collection: center_materials
// Document ID: {materialId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - title: string (required)
//   - teacherId: string (optional)
//   - subjectId: string (optional)
//
// Collection: center_students
// Document ID: {studentId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - fullName: string (required)
//   - studentCode: string (optional)
//   - studentUid: string (optional)
//
// Collection: center_enrollments
// Document ID: {enrollmentId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - studentId: string (required)
//   - groupId: string (required)
//   - studentUid: string (optional)
//
// Collection: center_sessions
// Document ID: {sessionId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - groupId: string (required)
//   - sessionDate: string (required)
//   - teacherId: string (optional)
//
// Collection: center_attendance
// Document ID: {attendanceId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - sessionId: string (required)
//   - studentId: string (required)
//   - status: string (required)
//   - studentUid: string (optional)
//
// Collection: center_invoices
// Document ID: {invoiceId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - studentId: string (required)
//   - totalAmount: number (required)
//   - status: string (optional)
//   - studentUid: string (optional)
//
// Collection: center_payments
// Document ID: {paymentId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - invoiceId: string (optional)
//   - studentId: string (optional)
//   - amountPaid: number (required)
//   - studentUid: string (optional)
//
// Collection: center_expenses
// Document ID: {expenseId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - amount: number (required)
//   - category: string (optional)
//
// Collection: center_shifts
// Document ID: {shiftId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - cashierUserId: string (required)
//   - status: string (optional)
//
// Collection: comprehensive_exams
// Document ID: {examId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - title: string (required)
//   - groupId: string (optional)
//   - teacherId: string (optional)
//
// Collection: exam_submissions
// Document ID: {submissionId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - examId: string (required)
//   - studentId: string (required)
//   - studentUid: string (optional)
//   - status: string (optional)
//
// Collection: users
// Document ID: {userId}
// Subcollection: profile/{profileDocId}
// Fields:
//   - id: string (optional) - User identifier
//   - uid: string (optional) - Firebase Auth UID
//   - tenantId: string (optional, immutable for non-owners) - Center/tenant ID
//   - role: string (optional) - User role (PLATFORM_OWNER, CENTER_ADMIN, TEACHER, STUDENT, etc.)
//   - fullName: string (optional, max 200 chars)
//   - username: string (optional, max 64 chars)
//   - email: string (optional, max 256 chars)
//   - phone: string (optional, max 32 chars)
//   - avatarUrl: string (optional, safe profile field, max 2048 chars)
//   - photoUrl: string (optional, safe profile field, max 2048 chars)
//   - avatar_url: string (optional, safe profile field, max 2048 chars)
//   - status / isActive: string/bool (optional)
//   - createdAt: string/timestamp (optional)
//   - updatedAt: string/timestamp (optional)
//
// Collection: system_usernames
// Document ID: {username}
// Fields:
//   - username: string (required, 3..64 chars, immutable)
//   - email: string (optional, max 256 chars)
//   - uid: string (optional, max 128 chars)
//   - teacherId: string (optional, max 128 chars)
//   - tenantId: string (required, max 128 chars, immutable)
//   - tenantSlug: string (optional, max 128 chars)
//   - createdAt: string/timestamp (optional)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasStaffDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff_memberships/$(request.auth.uid));
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      return hasStaffDoc() && staffDoc().isActive == true;
    }

    function staffRole() {
      return staffDoc().role;
    }

    function isPlatformOwner() {
      return isSignedIn() && (
        ('email' in request.auth.token && (
          request.auth.token.email.lower() in [
            'fathyelprimo@gmail.com',
            'zizo.infinity@gmail.com',
            'admin@yallacenter.com',
            'owner@yallacenter.com',
            'islam@yallacenter.com'
          ] ||
          request.auth.token.email.lower().matches('.*owner@.*')
        )) ||
        ('role' in request.auth.token && request.auth.token.role == 'PLATFORM_OWNER') ||
        ('isPlatformOwner' in request.auth.token && request.auth.token.isPlatformOwner == true) ||
        (isActiveStaff() && staffRole() == 'PLATFORM_OWNER')
      );
    }

    function isGradeAllowedRole() {
      return isActiveStaff() && (
        staffRole() == 'PLATFORM_OWNER' ||
        staffRole() == 'CENTER_ADMIN' ||
        staffRole() == 'BRANCH_MANAGER' ||
        staffRole() == 'RECEPTIONIST' ||
        staffRole() == 'TEACHER'
      );
    }

    function matchesTenant(tenantId) {
      return staffRole() == 'PLATFORM_OWNER' || staffDoc().tenantId == tenantId;
    }

    function matchesBranch(branchId) {
      return staffRole() == 'PLATFORM_OWNER' ||
        staffRole() == 'CENTER_ADMIN' ||
        !('branchIds' in staffDoc()) ||
        staffDoc().branchIds.size() == 0 ||
        branchId in staffDoc().branchIds;
    }

    function matchesTeacher(teacherId) {
      return staffRole() != 'TEACHER' ||
        staffDoc().teacherId == teacherId ||
        request.auth.uid == teacherId;
    }

    function isAuthorizedStaff(tenantId, branchId, teacherId) {
      return isGradeAllowedRole() &&
        matchesTenant(tenantId) &&
        matchesBranch(branchId) &&
        matchesTeacher(teacherId);
    }

    function isValidScoreNumber(score, totalMarks) {
      return score is number && score >= 0 && score <= totalMarks;
    }

    // Role-based authorization helpers
    function isStaffMember(tenantId) {
      return isPlatformOwner() || (isActiveStaff() && matchesTenant(tenantId));
    }

    function isCenterAdmin(tenantId) {
      return isPlatformOwner() || (
        isActiveStaff() && (
          staffRole() == 'CENTER_ADMIN' && matchesTenant(tenantId)
        )
      );
    }

    function isStudentOpsStaff(tenantId) {
      return isActiveStaff() && matchesTenant(tenantId) && (
        staffRole() == 'PLATFORM_OWNER' ||
        staffRole() == 'CENTER_ADMIN' ||
        staffRole() == 'BRANCH_MANAGER' ||
        staffRole() == 'RECEPTIONIST'
      );
    }

    function isSessionAllowedRole() {
      return isActiveStaff() && (
        staffRole() == 'PLATFORM_OWNER' ||
        staffRole() == 'CENTER_ADMIN' ||
        staffRole() == 'BRANCH_MANAGER' ||
        staffRole() == 'RECEPTIONIST' ||
        staffRole() == 'TEACHER'
      );
    }

    function isFinanceStaff(tenantId) {
      return isActiveStaff() && matchesTenant(tenantId) && (
        staffRole() == 'PLATFORM_OWNER' ||
        staffRole() == 'CENTER_ADMIN' ||
        staffRole() == 'ACCOUNTANT' ||
        staffRole() == 'RECEPTIONIST'
      );
    }

    function isStudentOwner(data) {
      return isSignedIn() && (
        ('studentUid' in data && data.studentUid == request.auth.uid) ||
        ('studentId' in data && data.studentId == request.auth.uid) ||
        ('id' in data && data.id == request.auth.uid)
      );
    }

    function isValidTenantId(tenantId) {
      return tenantId is string && tenantId.size() > 0 && tenantId.size() <= 128;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isCenterAdminForDoc(docData) {
      return isPlatformOwner() || (
        'tenantId' in docData && isCenterAdmin(docData.tenantId)
      );
    }

    function isSafeProfileUpdate() {
      let allowedKeys = ['avatarUrl', 'photoUrl', 'avatar_url', 'updatedAt'];
      let diff = request.resource.data.diff(resource.data);
      return diff.affectedKeys().hasOnly(allowedKeys) &&
        (!('avatarUrl' in request.resource.data) || request.resource.data.avatarUrl == null || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 2048)) &&
        (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl == null || (request.resource.data.photoUrl is string && request.resource.data.photoUrl.size() <= 2048)) &&
        (!('avatar_url' in request.resource.data) || request.resource.data.avatar_url == null || (request.resource.data.avatar_url is string && request.resource.data.avatar_url.size() <= 2048)) &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string || request.resource.data.updatedAt is timestamp);
    }

    function isValidUserDoc(data) {
      return (!('tenantId' in data) || (data.tenantId is string && isValidTenantId(data.tenantId))) &&
        (!('role' in data) || (data.role is string && data.role.size() <= 64)) &&
        (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 200)) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 32)) &&
        (!('avatarUrl' in data) || data.avatarUrl == null || data.avatarUrl is string) &&
        (!('photoUrl' in data) || data.photoUrl == null || data.photoUrl is string) &&
        (!('avatar_url' in data) || data.avatar_url == null || data.avatar_url is string) &&
        (!('teacherId' in data) || data.teacherId == null || (data.teacherId is string && data.teacherId.size() <= 128)) &&
        (!('permissions' in data) || data.permissions is list) &&
        (!('tabs' in data) || data.tabs is list);
    }

    function isValidUsernameData(data, username) {
      return data.username == username &&
        data.username is string &&
        data.username.size() >= 3 &&
        data.username.size() <= 64 &&
        data.tenantId is string &&
        isValidTenantId(data.tenantId) &&
        (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
        (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
        (!('teacherId' in data) || (data.teacherId is string && data.teacherId.size() <= 128)) &&
        (!('tenantSlug' in data) || (data.tenantSlug is string && data.tenantSlug.size() <= 128));
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // 1. Multi-tenant center tenants: public read for tenant resolution, managed by platform owner / center admin
    match /tenants/{tenantId} {
      allow read: if true;
      allow create, delete: if isPlatformOwner();
      allow update: if isPlatformOwner() || (
        isCenterAdmin(tenantId) &&
        request.resource.data.id == resource.data.id
      );
    }

    // 2. Staff memberships registry: tenant isolation & administrative management
    match /staff_memberships/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isPlatformOwner() ||
        (isCenterAdmin(resource.data.tenantId))
      );
      allow create: if isSignedIn() && (
        isPlatformOwner() ||
        request.auth.uid == uid ||
        isCenterAdmin(request.resource.data.tenantId)
      );
      allow update: if isPlatformOwner() || (
        isCenterAdmin(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId
      );
      allow delete: if isPlatformOwner() || isCenterAdmin(resource.data.tenantId);
    }

    // 2. Master data: Educational stages & grades (${tenantId}~${stageId})
    match /master_stages/{stageDocId} {
      allow read: if isActiveStaff() && matchesTenant(resource.data.tenantId);
      allow create: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(request.resource.data.tenantId))) &&
        request.resource.data.tenantId is string &&
        request.resource.data.nameAr is string;
      allow update: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId))) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId)));
    }

    // 3. Master data: Educational subjects (${tenantId}~${subjectId})
    match /master_subjects/{subjectDocId} {
      allow read: if isActiveStaff() && matchesTenant(resource.data.tenantId);
      allow create: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(request.resource.data.tenantId))) &&
        request.resource.data.tenantId is string &&
        request.resource.data.nameAr is string &&
        request.resource.data.grade is string;
      allow update: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId))) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId)));
    }

    // 4. Master data: Center branches (${tenantId}~${branchId})
    match /master_branches/{branchDocId} {
      allow read: if isActiveStaff() && matchesTenant(resource.data.tenantId);
      allow create: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(request.resource.data.tenantId))) &&
        request.resource.data.tenantId is string &&
        request.resource.data.nameAr is string;
      allow update: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId))) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId)));
    }

    // 5. Lesson exam definitions (totalMarks shared once per exam per session)
    match /lesson_exams/{examId} {
      allow read: if isActiveStaff() && matchesTenant(resource.data.tenantId) && matchesBranch(resource.data.branchId);
      allow create: if isAuthorizedStaff(
          request.resource.data.tenantId,
          request.resource.data.branchId,
          request.resource.data.teacherId
        ) &&
        request.resource.data.id == examId &&
        request.resource.data.totalMarks is number &&
        request.resource.data.totalMarks > 0 &&
        request.resource.data.totalMarks <= 1000 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.version == 1;
      allow update: if isAuthorizedStaff(
          resource.data.tenantId,
          resource.data.branchId,
          resource.data.teacherId
        ) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.groupId == resource.data.groupId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.totalMarks is number &&
        request.resource.data.totalMarks > 0 &&
        request.resource.data.totalMarks <= 1000 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }

    // 6. Student lesson grades: unique deterministic key ${examId}_${studentId}
    match /lesson_grades/{gradeId} {
      allow read: if (
        isActiveStaff() &&
        matchesTenant(resource.data.tenantId) &&
        matchesBranch(resource.data.branchId)
      ) || (
        isSignedIn() &&
        'studentUid' in resource.data &&
        resource.data.studentUid == request.auth.uid
      );

      allow create: if isAuthorizedStaff(
          request.resource.data.tenantId,
          request.resource.data.branchId,
          request.resource.data.teacherId
        ) &&
        gradeId == request.resource.data.examId + '_' + request.resource.data.studentId &&
        request.resource.data.id == gradeId &&
        request.resource.data.recordedByUid == request.auth.uid &&
        request.resource.data.version == 1 &&
        exists(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)) &&
        get(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)).data.tenantId == request.resource.data.tenantId &&
        get(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)).data.sessionId == request.resource.data.sessionId &&
        get(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)).data.groupId == request.resource.data.groupId &&
        isValidScoreNumber(
          request.resource.data.score,
          get(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)).data.totalMarks
        );

      allow update: if isAuthorizedStaff(
          resource.data.tenantId,
          resource.data.branchId,
          resource.data.teacherId
        ) &&
        gradeId == resource.data.examId + '_' + resource.data.studentId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.groupId == resource.data.groupId &&
        request.resource.data.examId == resource.data.examId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.recordedByUid == request.auth.uid &&
        request.resource.data.version == resource.data.version + 1 &&
        exists(/databases/$(database)/documents/lesson_exams/$(resource.data.examId)) &&
        isValidScoreNumber(
          request.resource.data.score,
          get(/databases/$(database)/documents/lesson_exams/$(resource.data.examId)).data.totalMarks
        );

      allow delete: if isAuthorizedStaff(
        resource.data.tenantId,
        resource.data.branchId,
        resource.data.teacherId
      );
    }

    // 7. Immutable grade audit trail
    match /lesson_grade_audits/{auditId} {
      allow read: if isActiveStaff() &&
        matchesTenant(resource.data.tenantId) &&
        matchesBranch(resource.data.branchId);
      allow create: if isAuthorizedStaff(
          request.resource.data.tenantId,
          request.resource.data.branchId,
          request.resource.data.teacherId
        ) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'tenantId',
          'branchId',
          'sessionId',
          'groupId',
          'examId',
          'action',
          'actorUid',
          'previousScore',
          'newScore',
          'timestamp'
        ]);
      allow update, delete: if false;
    }

    // 8. Center study groups
    match /center_groups/{groupId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isCenterAdmin(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.nameAr is string;
      allow update: if isCenterAdmin(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.nameAr is string;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 9. Center classrooms
    match /center_classrooms/{classroomId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isCenterAdmin(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.nameAr is string;
      allow update: if isCenterAdmin(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.nameAr is string;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 10. Teacher contractual profiles and login keys
    match /teacher_profiles/{profileId} {
      allow read: if isStaffMember(resource.data.tenantId) ||
        (isSignedIn() && (
          resource.data.id == request.auth.uid ||
          ('uid' in resource.data && resource.data.uid == request.auth.uid)
        ));
      allow create: if (isPlatformOwner() || isCenterAdmin(request.resource.data.tenantId)) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.fullName is string;
      allow update: if (isPlatformOwner() || isCenterAdmin(resource.data.tenantId)) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isPlatformOwner() || isCenterAdmin(resource.data.tenantId);
    }

    match /teacher_login_keys/{keyId} {
      allow read: if isStaffMember(resource.data.tenantId) ||
        (isSignedIn() && (
          resource.data.teacherId == request.auth.uid ||
          ('uid' in resource.data && resource.data.uid == request.auth.uid)
        ));
      allow create: if (isPlatformOwner() || isCenterAdmin(request.resource.data.tenantId)) &&
        isValidTenantId(request.resource.data.tenantId);
      allow update: if (isPlatformOwner() || isCenterAdmin(resource.data.tenantId)) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isPlatformOwner() || isCenterAdmin(resource.data.tenantId);
    }

    // 11. Center educational materials
    match /center_materials/{materialId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if (isPlatformOwner() || isCenterAdmin(request.resource.data.tenantId)) &&
        isValidTenantId(request.resource.data.tenantId) &&
        (('deleted' in request.resource.data && request.resource.data.deleted == true) || request.resource.data.title is string);
      allow update: if (isPlatformOwner() || isCenterAdmin(resource.data.tenantId)) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isPlatformOwner() || isCenterAdmin(resource.data.tenantId);
    }

    // 12. Center students directory
    match /center_students/{studentId} {
      allow read: if isStaffMember(resource.data.tenantId) || isStudentOwner(resource.data);
      allow create: if isStudentOpsStaff(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.fullName is string;
      allow update: if isStudentOpsStaff(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.fullName is string;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 13. Center student enrollments
    match /center_enrollments/{enrollmentId} {
      allow read: if isStaffMember(resource.data.tenantId) || isStudentOwner(resource.data);
      allow create: if isStudentOpsStaff(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.studentId is string &&
        request.resource.data.groupId is string;
      allow update: if isStudentOpsStaff(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.groupId == resource.data.groupId;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 14. Center class sessions
    match /center_sessions/{sessionId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isStaffMember(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        isSessionAllowedRole() &&
        request.resource.data.groupId is string &&
        request.resource.data.sessionDate is string &&
        (!('teacherId' in request.resource.data) || matchesTeacher(request.resource.data.teacherId));
      allow update: if isStaffMember(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        isSessionAllowedRole() &&
        (!('teacherId' in resource.data) || matchesTeacher(resource.data.teacherId));
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 15. Center session attendance
    match /center_attendance/{attendanceId} {
      allow read: if isStaffMember(resource.data.tenantId) || isStudentOwner(resource.data);
      allow create: if isStaffMember(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        isSessionAllowedRole() &&
        request.resource.data.sessionId is string &&
        request.resource.data.studentId is string;
      allow update: if isStaffMember(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        isSessionAllowedRole() &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.studentId == resource.data.studentId;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 16. Invoices & Payments
    match /center_invoices/{invoiceId} {
      allow read: if isStaffMember(resource.data.tenantId) || isStudentOwner(resource.data);
      allow create: if isFinanceStaff(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.studentId is string &&
        request.resource.data.totalAmount is number;
      allow update: if isFinanceStaff(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.studentId == resource.data.studentId;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    match /center_payments/{paymentId} {
      allow read: if isStaffMember(resource.data.tenantId) || isStudentOwner(resource.data);
      allow create: if isFinanceStaff(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.amountPaid is number &&
        request.resource.data.amountPaid >= 0;
      allow update: if isFinanceStaff(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.amountPaid is number &&
        request.resource.data.amountPaid >= 0;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 17. Expenses & Cashier Shifts
    match /center_expenses/{expenseId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isFinanceStaff(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.amount is number &&
        request.resource.data.amount >= 0;
      allow update: if isFinanceStaff(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.amount is number &&
        request.resource.data.amount >= 0;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    match /center_shifts/{shiftId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isFinanceStaff(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.cashierUserId is string;
      allow update: if isFinanceStaff(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 18. Comprehensive Exams & Submissions
    match /comprehensive_exams/{examId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isStaffMember(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        isSessionAllowedRole() &&
        request.resource.data.title is string;
      allow update: if isStaffMember(resource.data.tenantId) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        isSessionAllowedRole();
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    match /exam_submissions/{submissionId} {
      allow read: if isStaffMember(resource.data.tenantId) || isStudentOwner(resource.data);
      allow create: if (
          isStaffMember(request.resource.data.tenantId) ||
          isStudentOwner(request.resource.data)
        ) &&
        isValidTenantId(request.resource.data.tenantId) &&
        request.resource.data.examId is string &&
        request.resource.data.studentId is string;
      allow update: if (
          isStaffMember(resource.data.tenantId) ||
          isStudentOwner(resource.data)
        ) &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.examId == resource.data.examId &&
        request.resource.data.studentId == resource.data.studentId;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // Supporting operational revision and request collections
    match /center_group_revisions/{revisionId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isCenterAdmin(request.resource.data.tenantId) && isValidTenantId(request.resource.data.tenantId);
      allow update: if isCenterAdmin(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    match /center_material_revisions/{revisionId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isCenterAdmin(request.resource.data.tenantId) && isValidTenantId(request.resource.data.tenantId);
      allow update: if isCenterAdmin(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    match /teacher_extra_sessions/{requestId} {
      allow read: if isStaffMember(resource.data.tenantId);
      allow create: if isStaffMember(request.resource.data.tenantId) &&
        isValidTenantId(request.resource.data.tenantId) &&
        isSessionAllowedRole();
      allow update: if isCenterAdmin(resource.data.tenantId) && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isCenterAdmin(resource.data.tenantId);
    }

    // 19. System metadata & read-only collections (writes restricted to Firebase Admin SDK)
    match /system_metadata/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // 20. Users & Profile documents: self-profile updates & multi-tenant administrative isolation
    match /users/{userId} {
      allow read: if isOwner(userId) || isCenterAdminForDoc(resource.data);
      allow create: if isPlatformOwner() || (
        'tenantId' in request.resource.data &&
        isCenterAdmin(request.resource.data.tenantId) &&
        ('role' in request.resource.data ? request.resource.data.role != 'PLATFORM_OWNER' || isPlatformOwner() : true)
      );
      allow update: if (
        isOwner(userId) &&
        isSafeProfileUpdate()
      ) || (
        isPlatformOwner()
      ) || (
        isCenterAdminForDoc(resource.data) &&
        ('tenantId' in request.resource.data ? request.resource.data.tenantId == resource.data.tenantId : true) &&
        ('role' in request.resource.data ? request.resource.data.role != 'PLATFORM_OWNER' : true)
      );
      allow delete: if isPlatformOwner() || isCenterAdminForDoc(resource.data);
    }

    // 21. User profile subcollection documents (users/{userId}/profile)
    match /users/{userId}/profile/{profileDocId} {
      allow read: if isOwner(userId) || isCenterAdminForDoc(resource.data);
      allow create: if isPlatformOwner() || (
        'tenantId' in request.resource.data &&
        isCenterAdmin(request.resource.data.tenantId) &&
        ('role' in request.resource.data ? request.resource.data.role != 'PLATFORM_OWNER' || isPlatformOwner() : true)
      );
      allow update: if (
        isOwner(userId) &&
        isSafeProfileUpdate()
      ) || (
        isPlatformOwner()
      ) || (
        isCenterAdminForDoc(resource.data) &&
        ('tenantId' in request.resource.data ? request.resource.data.tenantId == resource.data.tenantId : true) &&
        ('role' in request.resource.data ? request.resource.data.role != 'PLATFORM_OWNER' : true)
      );
      allow delete: if isPlatformOwner() || isCenterAdminForDoc(resource.data);
    }

    // 22. System usernames registry for uniqueness checks and teacher onboarding
    match /system_usernames/{username} {
      allow read: if isSignedIn();
      allow create: if (
        isPlatformOwner() || (
          'tenantId' in request.resource.data &&
          isCenterAdmin(request.resource.data.tenantId)
        )
      ) && isValidUsernameData(request.resource.data, username);

      allow update: if (
        isPlatformOwner() || (
          isCenterAdminForDoc(resource.data) &&
          request.resource.data.tenantId == resource.data.tenantId
        )
      ) &&
      request.resource.data.username == username &&
      request.resource.data.tenantId == resource.data.tenantId &&
      isValidUsernameData(request.resource.data, username);

      allow delete: if isPlatformOwner() || isCenterAdminForDoc(resource.data);
    }

    // 23. Default closed guardrail
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
