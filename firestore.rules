rules_version = '2';

// ===============================================================
// Assumed Data Models
// ===============================================================
//
// Collection: staff_memberships
// Document ID: {uid} (Firebase Auth UID)
// Fields:
//   - uid: string (required) - Firebase Auth UID
//   - email: string (optional) - Staff email address
//   - displayName: string (optional) - Staff display name
//   - role: string (required) - PLATFORM_OWNER, CENTER_ADMIN, BRANCH_MANAGER, RECEPTIONIST, TEACHER
//   - tenantId: string (required) - Associated center/tenant identifier
//   - branchIds: list (optional) - Authorized branch IDs (empty or omitted means all branches)
//   - teacherId: string (optional) - Link to teacher record if role == 'TEACHER'
//   - isActive: bool (required) - Whether account is active
//
// Collection: master_stages
// Document ID: {tenantId}~{stageId}
// Fields:
//   - id: string (required) - Stage identifier
//   - tenantId: string (required, immutable) - Center/tenant ID
//   - nameAr: string (required) - Arabic stage title (e.g. الثانوية العامة)
//   - order: int/number (optional) - Display sort order
//   - grades: list of maps (optional) - Embedded educational grades
//   - createdAt: string/timestamp (optional)
//   - updatedAt: string/timestamp (optional)
//
// Collection: master_subjects
// Document ID: {tenantId}~{subjectId}
// Fields:
//   - id: string (required) - Subject identifier
//   - tenantId: string (required, immutable) - Center/tenant ID
//   - nameAr: string (required) - Arabic subject title (e.g. الرياضيات التطبيقية)
//   - code: string (optional) - Subject short code
//   - stage: string (required) - Associated stage ID
//   - grade: string (required) - Associated grade ID
//   - createdAt: string/timestamp (optional)
//   - updatedAt: string/timestamp (optional)
//
// Collection: master_branches
// Document ID: {tenantId}~{branchId}
// Fields:
//   - id: string (required) - Branch identifier
//   - tenantId: string (required, immutable) - Center/tenant ID
//   - nameAr: string (required) - Arabic branch name
//   - address: string (optional) - Branch street address
//   - phone: string (optional) - Branch telephone number
//   - isActive: bool (optional) - Branch active status
//   - createdAt: string/timestamp (optional)
//   - updatedAt: string/timestamp (optional)
//
// Collection: lesson_exams
// Document ID: {examId}
// Fields:
//   - id: string (required)
//   - tenantId: string (required, immutable)
//   - branchId: string (required, immutable)
//   - sessionId: string (required, immutable)
//   - groupId: string (required, immutable)
//   - teacherId: string (required)
//   - totalMarks: number (required, 1..1000)
//   - updatedByUid: string (required)
//   - version: int/number (required, incrementing)
//
// Collection: lesson_grades
// Document ID: {examId}_{studentId}
// Fields:
//   - id: string (required, must match {examId}_{studentId})
//   - tenantId: string (required, immutable)
//   - branchId: string (required)
//   - sessionId: string (required, immutable)
//   - groupId: string (required, immutable)
//   - examId: string (required, immutable)
//   - studentId: string (required, immutable)
//   - studentUid: string (optional, for student portal read)
//   - score: number (required, 0..totalMarks)
//   - recordedByUid: string (required)
//   - version: int/number (required, incrementing)
//
// Collection: lesson_grade_audits
// Document ID: {auditId}
// Fields:
//   - tenantId, branchId, sessionId, groupId, examId, action, actorUid,
//     previousScore, newScore, timestamp
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function hasStaffDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/staff_memberships/$(request.auth.uid));
    }

    function staffDoc() {
      return get(/databases/$(database)/documents/staff_memberships/$(request.auth.uid)).data;
    }

    function isActiveStaff() {
      return hasStaffDoc() && staffDoc().isActive == true;
    }

    function staffRole() {
      return staffDoc().role;
    }

    function isGradeAllowedRole() {
      return isActiveStaff() && (
        staffRole() == 'PLATFORM_OWNER' ||
        staffRole() == 'CENTER_ADMIN' ||
        staffRole() == 'BRANCH_MANAGER' ||
        staffRole() == 'RECEPTIONIST' ||
        staffRole() == 'TEACHER'
      );
    }

    function matchesTenant(tenantId) {
      return staffRole() == 'PLATFORM_OWNER' || staffDoc().tenantId == tenantId;
    }

    function matchesBranch(branchId) {
      return staffRole() == 'PLATFORM_OWNER' ||
        staffRole() == 'CENTER_ADMIN' ||
        !('branchIds' in staffDoc()) ||
        staffDoc().branchIds.size() == 0 ||
        branchId in staffDoc().branchIds;
    }

    function matchesTeacher(teacherId) {
      return staffRole() != 'TEACHER' ||
        staffDoc().teacherId == teacherId ||
        request.auth.uid == teacherId;
    }

    function isAuthorizedStaff(tenantId, branchId, teacherId) {
      return isGradeAllowedRole() &&
        matchesTenant(tenantId) &&
        matchesBranch(branchId) &&
        matchesTeacher(teacherId);
    }

    function isValidScoreNumber(score, totalMarks) {
      return score is number && score >= 0 && score <= totalMarks;
    }

    // ===============================================================
    // Collection Match Rules
    // ===============================================================

    // Staff permission registry: server-managed only (no client privilege escalation)
    match /staff_memberships/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (isActiveStaff() && (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && resource.data.tenantId == staffDoc().tenantId)))
      );
      allow write: if false;
    }

    // Master data: Educational stages & grades (${tenantId}~${stageId})
    match /master_stages/{stageDocId} {
      allow read: if isActiveStaff() && matchesTenant(resource.data.tenantId);
      allow create: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(request.resource.data.tenantId))) &&
        request.resource.data.tenantId is string &&
        request.resource.data.nameAr is string;
      allow update: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId))) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId)));
    }

    // Master data: Educational subjects (${tenantId}~${subjectId})
    match /master_subjects/{subjectDocId} {
      allow read: if isActiveStaff() && matchesTenant(resource.data.tenantId);
      allow create: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(request.resource.data.tenantId))) &&
        request.resource.data.tenantId is string &&
        request.resource.data.nameAr is string &&
        request.resource.data.grade is string;
      allow update: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId))) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId)));
    }

    // Master data: Center branches (${tenantId}~${branchId})
    match /master_branches/{branchDocId} {
      allow read: if isActiveStaff() && matchesTenant(resource.data.tenantId);
      allow create: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(request.resource.data.tenantId))) &&
        request.resource.data.tenantId is string &&
        request.resource.data.nameAr is string;
      allow update: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId))) &&
        request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if isActiveStaff() &&
        (staffRole() == 'PLATFORM_OWNER' || (staffRole() == 'CENTER_ADMIN' && matchesTenant(resource.data.tenantId)));
    }

    // Lesson exam definitions (totalMarks shared once per exam per session)
    match /lesson_exams/{examId} {
      allow read: if isActiveStaff() && matchesTenant(resource.data.tenantId) && matchesBranch(resource.data.branchId);
      allow create: if isAuthorizedStaff(
          request.resource.data.tenantId,
          request.resource.data.branchId,
          request.resource.data.teacherId
        ) &&
        request.resource.data.id == examId &&
        request.resource.data.totalMarks is number &&
        request.resource.data.totalMarks > 0 &&
        request.resource.data.totalMarks <= 1000 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.version == 1;
      allow update: if isAuthorizedStaff(
          resource.data.tenantId,
          resource.data.branchId,
          resource.data.teacherId
        ) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.groupId == resource.data.groupId &&
        request.resource.data.branchId == resource.data.branchId &&
        request.resource.data.totalMarks is number &&
        request.resource.data.totalMarks > 0 &&
        request.resource.data.totalMarks <= 1000 &&
        request.resource.data.updatedByUid == request.auth.uid &&
        request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }

    // Student lesson grades: unique deterministic key ${examId}_${studentId}
    match /lesson_grades/{gradeId} {
      allow read: if (
        isActiveStaff() &&
        matchesTenant(resource.data.tenantId) &&
        matchesBranch(resource.data.branchId)
      ) || (
        isSignedIn() &&
        'studentUid' in resource.data &&
        resource.data.studentUid == request.auth.uid
      );

      allow create: if isAuthorizedStaff(
          request.resource.data.tenantId,
          request.resource.data.branchId,
          request.resource.data.teacherId
        ) &&
        gradeId == request.resource.data.examId + '_' + request.resource.data.studentId &&
        request.resource.data.id == gradeId &&
        request.resource.data.recordedByUid == request.auth.uid &&
        request.resource.data.version == 1 &&
        exists(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)) &&
        get(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)).data.tenantId == request.resource.data.tenantId &&
        get(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)).data.sessionId == request.resource.data.sessionId &&
        get(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)).data.groupId == request.resource.data.groupId &&
        isValidScoreNumber(
          request.resource.data.score,
          get(/databases/$(database)/documents/lesson_exams/$(request.resource.data.examId)).data.totalMarks
        );

      allow update: if isAuthorizedStaff(
          resource.data.tenantId,
          resource.data.branchId,
          resource.data.teacherId
        ) &&
        gradeId == resource.data.examId + '_' + resource.data.studentId &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.tenantId == resource.data.tenantId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.groupId == resource.data.groupId &&
        request.resource.data.examId == resource.data.examId &&
        request.resource.data.studentId == resource.data.studentId &&
        request.resource.data.recordedByUid == request.auth.uid &&
        request.resource.data.version == resource.data.version + 1 &&
        exists(/databases/$(database)/documents/lesson_exams/$(resource.data.examId)) &&
        isValidScoreNumber(
          request.resource.data.score,
          get(/databases/$(database)/documents/lesson_exams/$(resource.data.examId)).data.totalMarks
        );

      allow delete: if isAuthorizedStaff(
        resource.data.tenantId,
        resource.data.branchId,
        resource.data.teacherId
      );
    }

    // Immutable grade audit trail
    match /lesson_grade_audits/{auditId} {
      allow read: if isActiveStaff() &&
        matchesTenant(resource.data.tenantId) &&
        matchesBranch(resource.data.branchId);
      allow create: if isAuthorizedStaff(
          request.resource.data.tenantId,
          request.resource.data.branchId,
          request.resource.data.teacherId
        ) &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.keys().hasAll([
          'tenantId',
          'branchId',
          'sessionId',
          'groupId',
          'examId',
          'action',
          'actorUid',
          'previousScore',
          'newScore',
          'timestamp'
        ]);
      allow update, delete: if false;
    }

    // Default closed guardrail
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
